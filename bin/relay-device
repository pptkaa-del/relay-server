#!/bin/bash
# Управление релейными платами: учётные записи MQTT, права доступа (ACL) и запись в БД.
#
#   sudo relay-device add  <ID> ["Название"] ["Адрес"]  — добавить плату
#   sudo relay-device del  <ID>                         — удалить доступ платы к брокеру
#   sudo relay-device add-many <ID,ID,…>                — учётные записи MQTT сразу для многих плат
#                                                         (ACL и перечитывание брокера — один раз; БД не трогает)
#   sudo relay-device list                              — список плат
#   sudo relay-device pass <ID>                         — показать MQTT-логин и пароль платы
#   sudo relay-device sync-acl                          — пересобрать ACL из файла паролей
#   sudo relay-device sync-accounts                     — создать недостающие учётные записи MQTT всем устройствам панели
#                                                         (кроме тех, у кого включено «не принимать сообщения»)
#   sudo relay-device block   <ID>                      — не принимать сообщения: убрать учётную запись платы из брокера
#                                                         (брокер сразу отключает плату и не пускает обратно)
#   sudo relay-device unblock <ID>                      — снова принимать: вернуть учётную запись платы
#   sudo relay-device user-add <логин> [пароль]         — добавить/сменить пароль пользователя веб-панели
#   sudo relay-device user-del <логин>                  — удалить пользователя веб-панели
#   sudo relay-device mqtt-user-add <логин> [пароль] [rw|read] — дополнительный пользователь брокера MQTT
#                                                         (rw — чтение и запись всех топиков, read — только чтение)
#   sudo relay-device mqtt-user-del <логин>             — удалить дополнительного пользователя MQTT
#   sudo relay-device mqtt-user-list                    — список дополнительных пользователей MQTT
set -euo pipefail

ENV_FILE=/etc/relay-server/install.env
PASSWD=/etc/mosquitto/passwd
ACL=/etc/mosquitto/relay.acl
USERS=/etc/relay-server/users.php
# дополнительные пользователи MQTT: «логин:хэш_mosquitto:rw|read» (хэш — как в $PASSWD)
MQTT_USERS=/etc/relay-server/mqtt-users.conf

[ "$(id -u)" -eq 0 ] || { echo "Запускайте через sudo" >&2; exit 1; }
[ -r "$ENV_FILE" ] || { echo "Не найден $ENV_FILE — сначала выполните install.sh" >&2; exit 1; }
# shellcheck source=/dev/null
. "$ENV_FILE"

die() { echo "Ошибка: $*" >&2; exit 1; }
check_id() { [[ "${1:-}" =~ ^[1-9][0-9]{0,9}$ ]] || die "ID платы должен быть целым числом без ведущих нулей"; }
sql_str() { local s=${1//\\/\\\\}; printf "'%s'" "${s//\'/\'\'}"; }
db() { mysql --default-character-set=utf8mb4 "$DB_NAME" "$@"; }

# Пароль платы — как в прошивке: hex первых 16 байт SHA256("relay-<ID>")
device_pass() { printf 'relay-%s' "$1" | sha256sum | cut -c1-32; }

reload_mosquitto() {
    systemctl is-active --quiet mosquitto || return 0   # брокер не запущен — новые файлы прочитает при старте
    systemctl reload mosquitto 2>/dev/null || systemctl restart mosquitto \
        || echo "Внимание: не удалось перезагрузить mosquitto, см. journalctl -u mosquitto" >&2
}

sync_acl() {
    local tmp
    tmp=$(mktemp)
    {
        echo "# Сгенерировано relay-device. Не редактируйте вручную."
        echo "user $MQTT_USER"
        echo "topic readwrite #"
        echo 'topic read $SYS/broker/log/#'
        echo
        # дополнительные пользователи (mqtt-user-add или config/mqtt-users.conf из репозитория)
        if [ -f "$MQTT_USERS" ]; then
            while IFS=: read -r u _ mode; do
                [[ "$u" =~ ^[A-Za-z0-9_.@-]+$ ]] || continue
                if [ "${mode:-rw}" = "read" ]; then
                    printf 'user %s\ntopic read #\n\n' "$u"
                else
                    printf 'user %s\ntopic readwrite #\n\n' "$u"
                fi
            done < <(grep -v '^[[:space:]]*\(#\|$\)' "$MQTT_USERS")
        fi
        # «|| true»: если плат ещё нет, grep ничего не находит, а с pipefail это прервало бы скрипт
        { grep -oE '^relay-[0-9]+:' "$PASSWD" 2>/dev/null || true; } | tr -d ':' | sort -t- -k2 -n | while read -r u; do
            id=${u#relay-}
            printf 'user %s\ntopic read com/%s\ntopic write stat\ntopic write rep\n\n' "$u" "$id"
        done
    } > "$tmp"
    install -m 600 -o mosquitto -g mosquitto "$tmp" "$ACL"
    rm -f "$tmp"
}

case "${1:-}" in
    add)
        check_id "${2:-}"
        id=$2; name=${3:-"Устройство $id"}; addr=${4:-}
        pass=$(device_pass "$id")
        mosquitto_passwd -b "$PASSWD" "relay-$id" "$pass" 2>/dev/null || die "mosquitto_passwd: не удалось записать $PASSWD"
        chown mosquitto:mosquitto "$PASSWD"; chmod 600 "$PASSWD"
        sync_acl
        # для уже существующей платы меняем только явно переданные название/адрес
        upd="id = id"
        [ $# -ge 3 ] && upd="$upd, name_obj = VALUES(name_obj)"
        [ $# -ge 4 ] && upd="$upd, address = VALUES(address)"
        db -e "INSERT INTO general_info (id, name_obj, address, coordinates, name_reley_1, name_reley_2, name_reley_3, name_reley_4)
               VALUES ($id, $(sql_str "$name"), $(sql_str "$addr"), '', 'Реле 1', 'Реле 2', 'Реле 3', 'Реле 4')
               ON DUPLICATE KEY UPDATE $upd;"
        reload_mosquitto
        echo "Плата $id добавлена."
        echo "  MQTT логин:  relay-$id"
        echo "  MQTT пароль: $pass"
        echo "  Топик команд: com/$id"
        ;;
    add-many)
        [[ "${2:-}" =~ ^[1-9][0-9]{0,9}(,[1-9][0-9]{0,9})*$ ]] || die "использование: add-many <ID,ID,…>"
        n=0
        IFS=, read -r -a ids <<< "$2"
        for id in "${ids[@]}"; do
            mosquitto_passwd -b "$PASSWD" "relay-$id" "$(device_pass "$id")" 2>/dev/null || die "mosquitto_passwd: не удалось записать $PASSWD (плата $id)"
            n=$((n + 1))
        done
        chown mosquitto:mosquitto "$PASSWD"; chmod 600 "$PASSWD"
        sync_acl
        reload_mosquitto
        echo "Учётные записи MQTT созданы для плат: $n."
        ;;
    del)
        check_id "${2:-}"
        mosquitto_passwd -D "$PASSWD" "relay-$2" 2>/dev/null || true
        sync_acl
        reload_mosquitto
        echo "Доступ платы $2 к брокеру удалён (история в БД сохранена)."
        echo "Удалить плату из панели: mysql $DB_NAME -e 'DELETE FROM general_info WHERE id=$2; DELETE FROM devices WHERE id=$2;'"
        ;;
    list)
        db -t -e "SELECT g.id AS ID, g.name_obj AS Название, g.address AS Адрес,
                         d.last_seen AS 'Последний stat',
                         CASE WHEN d.last_seen IS NULL THEN 'нет данных'
                              WHEN d.status = 0 OR d.last_seen < NOW() - INTERVAL 350 SECOND THEN 'оффлайн'
                              WHEN d.status = 2 THEN 'ошибка' ELSE 'онлайн' END AS Статус
                  FROM general_info g LEFT JOIN devices d ON d.id = g.id ORDER BY g.id;"
        ;;
    pass)
        check_id "${2:-}"
        echo "MQTT логин:  relay-$2"
        echo "MQTT пароль: $(device_pass "$2")"
        ;;
    block)
        check_id "${2:-}"
        mosquitto_passwd -D "$PASSWD" "relay-$2" 2>/dev/null || true
        sync_acl
        reload_mosquitto   # при перечитывании mosquitto отключает плату, которой больше нет в файле паролей
        echo "Сообщения от платы $2 не принимаются (брокер её не пускает)."
        ;;
    unblock)
        check_id "${2:-}"
        mosquitto_passwd -b "$PASSWD" "relay-$2" "$(device_pass "$2")" 2>/dev/null || die "mosquitto_passwd: не удалось записать $PASSWD"
        chown mosquitto:mosquitto "$PASSWD"; chmod 600 "$PASSWD"
        sync_acl
        reload_mosquitto
        echo "Сообщения от платы $2 снова принимаются."
        ;;
    sync-accounts)
        n=0
        while read -r id; do
            [[ "$id" =~ ^[1-9][0-9]{0,9}$ ]] || continue
            grep -q "^relay-$id:" "$PASSWD" 2>/dev/null && continue
            mosquitto_passwd -b "$PASSWD" "relay-$id" "$(device_pass "$id")" 2>/dev/null || die "mosquitto_passwd: не удалось записать $PASSWD (плата $id)"
            n=$((n + 1))
        done < <(db -N -e "SELECT id FROM general_info WHERE mqtt_block_at IS NULL ORDER BY id" 2>/dev/null \
                 || db -N -e "SELECT id FROM general_info ORDER BY id")
        if [ "$n" -gt 0 ]; then
            chown mosquitto:mosquitto "$PASSWD"; chmod 600 "$PASSWD"
            sync_acl
            reload_mosquitto
        fi
        echo "Недостающих учётных записей MQTT создано: $n."
        ;;
    sync-acl)
        sync_acl; reload_mosquitto; echo "ACL обновлён: $ACL"
        ;;
    user-add)
        login=${2:-}; [[ "$login" =~ ^[A-Za-z0-9_.@-]{1,64}$ ]] || die "логин: латиница, цифры, _ . @ -"
        pw=${3:-}
        if [ -z "$pw" ]; then read -r -s -p "Пароль для $login: " pw; echo; fi
        [ ${#pw} -ge 6 ] || die "пароль короче 6 символов"
        RELAY_LOGIN="$login" RELAY_PASS="$pw" php -r '
            $f = $argv[1]; $u = is_file($f) ? require $f : [];
            $u[getenv("RELAY_LOGIN")] = password_hash(getenv("RELAY_PASS"), PASSWORD_DEFAULT);
            file_put_contents($f, "<?php\nreturn " . var_export($u, true) . ";\n");' "$USERS"
        chown root:www-data "$USERS"; chmod 640 "$USERS"
        echo "Пользователь панели $login сохранён."
        ;;
    mqtt-user-add)
        login=${2:-}; [[ "$login" =~ ^[A-Za-z0-9_.@-]{1,64}$ ]] || die "логин: латиница, цифры, _ . @ -"
        [[ "$login" =~ ^relay-[0-9]+$ || "$login" = "$MQTT_USER" ]] && die "логин $login занят платой или сервером"
        pw=${3:-}
        mode=${4:-rw}; [[ "$mode" = rw || "$mode" = read ]] || die "права: rw или read"
        if [ -z "$pw" ]; then read -r -s -p "Пароль MQTT для $login: " pw; echo; fi
        [ ${#pw} -ge 6 ] || die "пароль короче 6 символов"
        tmp=$(mktemp); mosquitto_passwd -c -b "$tmp" "$login" "$pw" 2>/dev/null || { rm -f "$tmp"; die "mosquitto_passwd не сработал"; }
        hash=$(cut -d: -f2- "$tmp"); rm -f "$tmp"
        touch "$MQTT_USERS"; chmod 600 "$MQTT_USERS"
        { grep -v "^$login:" "$MQTT_USERS" || true; echo "$login:$hash:$mode"; } > "$MQTT_USERS.new" && mv "$MQTT_USERS.new" "$MQTT_USERS"
        chmod 600 "$MQTT_USERS"
        mosquitto_passwd -b "$PASSWD" "$login" "$pw" 2>/dev/null || die "mosquitto_passwd: не удалось записать $PASSWD"
        chown mosquitto:mosquitto "$PASSWD"; chmod 600 "$PASSWD"
        sync_acl; reload_mosquitto
        echo "Пользователь MQTT $login сохранён ($([ "$mode" = read ] && echo 'только чтение' || echo 'чтение и запись'))."
        ;;
    mqtt-user-del)
        login=${2:-}; [[ "$login" =~ ^[A-Za-z0-9_.@-]{1,64}$ ]] || die "укажите логин"
        [ -f "$MQTT_USERS" ] && { grep -v "^$login:" "$MQTT_USERS" > "$MQTT_USERS.new" || true; mv "$MQTT_USERS.new" "$MQTT_USERS"; chmod 600 "$MQTT_USERS"; }
        mosquitto_passwd -D "$PASSWD" "$login" 2>/dev/null || true
        sync_acl; reload_mosquitto
        echo "Пользователь MQTT $login удалён."
        ;;
    mqtt-user-list)
        [ -s "$MQTT_USERS" ] || { echo "Дополнительных пользователей MQTT нет."; exit 0; }
        grep -v '^[[:space:]]*\(#\|$\)' "$MQTT_USERS" | while IFS=: read -r u _ mode; do
            echo "$u — $([ "${mode:-rw}" = read ] && echo 'только чтение' || echo 'чтение и запись')"
        done
        ;;
    user-del)
        RELAY_LOGIN="${2:-}" php -r '
            $f = $argv[1]; $u = require $f; unset($u[getenv("RELAY_LOGIN")]);
            file_put_contents($f, "<?php\nreturn " . var_export($u, true) . ";\n");' "$USERS"
        echo "Пользователь панели ${2:-} удалён."
        ;;
    *)
        sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
